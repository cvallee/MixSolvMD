title                   = NVT equilibration
define                  = -DPOSRES
integrator              = md
dt                      = 0.001
nsteps                  = 100000 ; 100 ps
nstenergy               = 1000
nstlog                  = 1000
;
pbc                     = xyz
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
tcoupl                  = V-rescale
tc_grps                 = system
tau_t                   = 1.0
ref_t                   = 310.15
;
constraints             = h-bonds
constraint_algorithm    = LINCS
;
gen-vel                 = yes
gen-temp                = 310.15
gen-seed                = -1
